# 复制为 .env 后填写（.env 已被 git 忽略）
# Notion integration token，在 https://www.notion.so/my-integrations 创建后获取
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 博客数据库页面的 32 位 ID
NOTION_DATABASE_ID=744ac9a9f88b829d80740117f314e8f1

# 二选一：页面树模式。填了它就优先按页面树同步，忽略 NOTION_DATABASE_ID
# 该页面下的每个一级子页面 = 一篇博客文章
NOTION_ROOT_PAGE_ID=244ac9a9-f88b-8093-8158-fcab733848b3

# 可选：不参与同步的 slug，逗号分隔（用来排除模板示例文章）
NOTION_EXCLUDE_SLUGS=
