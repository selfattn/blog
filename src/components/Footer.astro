---
import { siteConfig } from '../config';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-left">
      <p>© {year} {siteConfig.author}</p>
      <p class="site-stats">
        <span>本站访问 <span id="vercount_value_site_pv">–</span> 次</span>
        <span class="dot" aria-hidden="true"></span>
        <span>访客 <span id="vercount_value_site_uv">–</span> 人</span>
      </p>
    </div>
    <p class="footer-links">
      <a href={`${base}rss.xml`}>RSS</a>
      <span class="dot" aria-hidden="true"></span>
      <a href={`${base}about`}>关于</a>
      <span class="dot" aria-hidden="true"></span>
      <span>
        Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      </span>
    </p>
  </div>
</footer>
