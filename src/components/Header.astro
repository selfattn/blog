---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../config';

const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container">
    <nav class="nav">
      <a href={base} class="logo">
        <span class="logo-mark" aria-hidden="true">Z</span>
        <span class="logo-text">{siteConfig.title}</span>
      </a>
      <div class="nav-links">
        <a href={base}>文章</a>
        <a href={`${base}tags/`}>标签</a>
        <a href={`${base}about`}>关于</a>
        <a href={`${base}rss.xml`}>RSS</a>
      </div>
      <ThemeToggle />
    </nav>
  </div>
</header>
