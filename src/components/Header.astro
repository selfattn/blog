---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../config';

const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container">
    <nav class="nav">
      <a href={base} class="logo">{siteConfig.title}</a>
      <div class="nav-links">
        <a href={base}>首页</a>
        <a href={`${base}about`}>关于</a>
      </div>
      <ThemeToggle />
    </nav>
  </div>
</header>
