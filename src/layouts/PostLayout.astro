---
import BaseLayout from './BaseLayout.astro';
import Comment from '../components/Comment.astro';
import { formatDate, readingTime } from '../utils';
import { tagSlug } from '../lib/tags';
import type { PostEntry } from '../types';
import 'katex/dist/katex.min.css';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const base = import.meta.env.BASE_URL;
// Notion 文章的 description 是从正文自动截取的，再显示一遍会重复
const showLede = Boolean(description) && !post.data.notionId;
---
<BaseLayout title={title} description={description}>
  <div class="reading-progress" aria-hidden="true">
    <span id="reading-progress"></span>
  </div>

  <article class="post">
    <a class="back-link" href={base}>← 全部文章</a>

    <header class="post-header">
      <div class="post-kicker">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot"></span>
        <span>{readingTime(post.body)}</span>
      </div>
      <h1>{title}</h1>
      {showLede && <p class="post-lede">{description}</p>}
      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a class="tag" href={`${base}tags/${tagSlug(tag)}/`}>
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <Comment />
</BaseLayout>

<script is:inline>
  (function () {
    var bar = document.getElementById('reading-progress');
    var article = document.querySelector('.prose');
    if (!bar || !article) return;

    function update() {
      var start = article.offsetTop - 120;
      var end = article.offsetTop + article.offsetHeight - window.innerHeight + 120;
      var ratio = end > start ? (window.scrollY - start) / (end - start) : 0;
      bar.style.width = Math.max(0, Math.min(1, ratio)) * 100 + '%';
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
