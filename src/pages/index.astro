---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../config';
import { getPosts } from '../utils';
import { getReadingPath } from '../lib/reading-path';

const posts = await getPosts();
const readingPath = getReadingPath(posts);
const base = import.meta.env.BASE_URL;
const latest = posts[0]?.data.pubDate;
const updated = latest
  ? latest.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit' })
  : '';
---
<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="hero">
    <p class="eyebrow">RL · Agents · Systems</p>
    <h1><em>{siteConfig.title}</em></h1>
    <p class="hero-lede">
      记录强化学习、Agent 系统与工程实践中的推导与踩坑。
    </p>
    <div class="hero-meta">
      <span>{posts.length} 篇文章</span>
      <span class="dot"></span>
      {updated && <span>更新于 {updated}</span>}
      {updated && <span class="dot"></span>}
      <a href={`${base}rss.xml`}>RSS 订阅</a>
    </div>
  </section>

  {readingPath.length > 0 && <section class="reading-path" aria-labelledby="reading-path-title">
    <div class="section-head">
      <h2 id="reading-path-title">从这里开始</h2>
      <span>强化学习阅读路径</span>
    </div>
    <ol class="path-stages">
      {readingPath.map((stage, index) => <li class="path-stage">
        <span class="path-number">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h3>{stage.title}</h3>
          <p>{stage.description}</p>
          <ul>
            {stage.posts.map((post) => <li><a href={`${base}${post.id}/`}>{post.data.title} <span aria-hidden="true">↗</span></a></li>)}
          </ul>
        </div>
      </li>)}
    </ol>
  </section>}

  <section>
    <div class="section-head">
      <h2>全部文章</h2>
      <span>{String(posts.length).padStart(2, '0')}</span>
    </div>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
    {posts.length === 0 && <p class="comments-hint">还没有文章，快写一篇吧。</p>}
  </section>
</BaseLayout>
