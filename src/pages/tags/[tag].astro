---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';
import { collectTags, postsWithTag, tagSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((item) => ({
    params: { tag: item.slug },
    props: { tag: item.tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const posts = postsWithTag(await getPosts(), tagSlug(tag));
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的文章`}>
  <section class="hero tag-hero">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p class="hero-lede">{posts.length} 篇文章</p>
    <a class="back-link" href={`${base}tags/`}>← 全部标签</a>
  </section>

  <div class="post-list">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </div>
</BaseLayout>
